# Salin file ini menjadi `.env` lalu isi yang perlu saja:
#   copy .env.example .env
# Default semua fitur jalan TANPA mengisi apa pun (provider auto gratis,
# OCR tesseract, bubble fallback aman). Isi variabel di bawah hanya kalau
# memakai fitur opsionalnya. Cek status di http://localhost:3000/api/health
# setelah `npm run dev`.

# --- Translate OpenRouter (key bisa diisi lewat UI atau env) ---
# Key UI diprioritaskan; kosongkan input UI untuk memakai key env ini.
# Dipakai kalau dropdown "Provider translate" = openrouter.
# Daftar + ambil key di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxx
# Model default: murah + bagus untuk EN->ID. Alternatif:
#   google/gemini-2.5-flash | deepseek/deepseek-chat | openai/gpt-4o-mini | anthropic/claude-3.5-haiku
# Konten dewasa (model umum menolak/menyensor): z-ai/glm-5.3-flash
OPENROUTER_MODEL=google/gemini-2.5-flash
# Opsional (untuk ranking OpenRouter, boleh dikosongkan)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=komik-ocr-next

# --- Bubble YOLO (opsional, default AKTIF dengan fallback aman) ---
# Butuh Python + ultralytics + model (lihat README "Bubble YOLO").
# Kalau Python/model tidak ada, otomatis fallback ke OCR full-page.
BUBBLE_ENABLED=1
# BUBBLE_ENABLED=0 untuk mematikan total. BUBBLE_PYTHON dikosongkan =
# coba otomatis: python -> py -> python3 (Windows).
BUBBLE_PYTHON=
# Pilihan: ogkalu (komik barat + manga + webtoon) | psimera (manga).
# Bisa dioverride per-request dari dropdown form (bubble=ogkalu/psimera/0).
BUBBLE_MODEL=ogkalu
BUBBLE_CONF=0.3
BUBBLE_IMGSZ=1024
BUBBLE_MAX=40
# Batas sisi minimum bubble (px) dan timeout 1 panggilan per job (ms).
# BUBBLE_MIN_SIDE=24
# BUBBLE_TIMEOUT_MS=300000
# --- Bentuk bubble / kontur (mask mengikuti outline asli, fallback elips) ---
# BUBBLE_SHAPE=0 untuk mematikan ekstraksi kontur (langsung elips seperti dulu).
# BUBBLE_SHAPE_TIMEOUT_MS=120000 (1 panggilan per halaman, tanpa torch: cepat)
# BUBBLE_SHAPE_EPSILON=0.01 (approxPolyDP, fraksi perimeter)
# BUBBLE_SHAPE_MIN_AREA=0.15 (luas kontur minimum, fraksi luas crop)

# --- OCR engine (dropdown "OCR engine" di form, default tesseract) ---
# Pilihan: tesseract (tanpa install tambahan) | comics_text_plus
# (perlu pip + checkpoint, lihat bawah) | vision_llm (perlu OPENROUTER_API_KEY)
# | google_vision (perlu GOOGLE_VISION_API_KEY di bawah, berbayar per unit).
# Env ini hanya default server-side: pilihan di form / query (?ocrEngine=)
# SELALU menang per-request.
# OCR_ENGINE=tesseract

# --- OCR google_vision (Google Cloud Vision API, opsional/berbayar) ---
# Dipakai kalau ocrEngine=google_vision. Key BISA diisi lewat kolom
# "API key Google Vision" di UI (diprioritaskan) atau env ini.
# Buat key di Google Cloud Console (API & Services > Credentials),
# lalu aktifkan "Cloud Vision API" di project yang sama.
# Kuota: full-page = ±1 unit/halaman; per-crop bubble = ±1 unit/bubble.
GOOGLE_VISION_API_KEY=
# Batas waktu tunggu per 1 request batch (ms).
# GOOGLE_VISION_TIMEOUT_MS=60000
# Region bubble dari blok teks (dipakai bila dropdown bubble = Google):
# GOOGLE_REGION_GAP=24 (jarak tepi px agar dua blok digabung satu region),
# GOOGLE_REGION_PAD=12 (margin px di sekeliling region agar outline masuk).

# --- OCR vision_llm (Vision LLM via OpenRouter, opsional) ---
# Dipakai kalau ocrEngine=vision_llm: teks dibaca langsung dari crop bubble
# oleh model vision. API key REUSE OPENROUTER_API_KEY di atas (sama seperti
# translate) — TIDAK perlu key baru. Variabel di bawah ini OPSIONAL semua
# (ada default di kode lib/ocrVisionLLM.ts).
# Model default murah + akurat untuk baca teks gambar. Alternatif:
#   openai/gpt-4o-mini | google/gemini-2.5-flash
# Konten dewasa: z-ai/glm-5.3-flash
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
# Batas waktu tunggu per 1 bubble (ms). Naikkan kalau sering timeout.
# OPENROUTER_VISION_TIMEOUT_MS=60000

# --- Translate OpenCode (provider=opencode, opsional/legacy) ---
# Dipakai kalau dropdown "Provider translate" = opencode: butuh server
# OpenCode lokal sedang jalan (`opencode serve`).
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# --- OCR comics_text_plus (FCENet + MASTER, opsional) ---
# Dipakai kalau ocrEngine=comics_text_plus. Butuh Python 3.9 venv + paket
# comics-ocr (torch 1.9 tidak bisa di Python 3.12), misal:
# COMICS_PYTHON=C:\venvs\comics\Scripts\python.exe
# Kalau Drive penulis terkunci, pakai bobot dasar publik (file *_base-*.pth
# di detector/models/comics_text_plus/) dengan mengisi 2 var ini:
# COMICS_DET_CKPT=detector/models/comics_text_plus/fcenet_r50dcnv2_fpn_1500e_ctw1500_base-e326d7ec.pth
# COMICS_RECOG_CKPT=detector/models/comics_text_plus/master_r31_12e_ST_MJ_SA_base-787edd36.pth
# Threshold confidence 0..1, timeout load model CPU (ms), maks box/halaman.
# COMICS_CONF=0.3
# COMICS_TIMEOUT_MS=300000
# COMICS_MAX=200
# COMICS_MIN_SIDE=8
# COMICS_STITCH=0 untuk mematikan penjahitan baris jadi bubble (debug).
