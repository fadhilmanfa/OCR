# --- OpenRouter (provider=openrouter, hasil natural, WAJIB isi untuk gaya non-kaku) ---
# Daftar + ambil key di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxx
# Model default: murah + bagus untuk EN->ID. Alternatif:
#   google/gemini-2.5-flash | deepseek/deepseek-chat | openai/gpt-4o-mini | anthropic/claude-3.5-haiku
OPENROUTER_MODEL=google/gemini-2.5-flash
# Opsional (untuk ranking OpenRouter, boleh dikosongkan)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=komik-ocr-next

# --- Bubble YOLO (opsional, default AKTIF dengan fallback aman) ---
# Butuh Python + ultralytics + model (lihat README "Bubble YOLO").
# Kalau Python/model tidak ada, otomatis fallback ke OCR full-page.
# BUBBLE_ENABLED=0 untuk mematikan total. BUBBLE_PYTHON dikosongkan =
# coba otomatis: python -> py -> python3 (Windows).
BUBBLE_ENABLED=1
BUBBLE_PYTHON=
BUBBLE_MODEL=ogkalu
# Pilihan: ogkalu (komik barat + manga + webtoon) | psimera (manga).
# Bisa dioverride per-request dari dropdown form (bubble=ogkalu/psimera/0).
BUBBLE_CONF=0.3
BUBBLE_IMGSZ=1024
BUBBLE_MAX=40

# --- OCR vision_llm (Vision LLM via OpenRouter, opsional) ---
# Dipakai kalau ocrEngine=vision_llm: teks dibaca langsung dari crop bubble
# oleh model vision. API key REUSE OPENROUTER_API_KEY di atas (sama seperti
# translate) — TIDAK perlu key baru. Variabel di bawah ini OPSIONAL semua
# (ada default di kode lib/ocrVisionLLM.ts).
# Model default murah + akurat untuk baca teks gambar. Alternatif:
#   openai/gpt-4o-mini | google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
# Batas waktu tunggu per 1 bubble (ms). Naikkan kalau sering timeout.
# OPENROUTER_VISION_TIMEOUT_MS=60000

# --- OpenCode (provider=opencode, opsional/legacy) ---
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# --- OCR comics_text_plus (FCENet + MASTER, opsional) ---
# Default menunjuk ke nama file fine-tune asli di
# detector/models/comics_text_plus/ (lihat detector/ocr_comics.py).
# Kalau Drive penulis terkunci, pakai bobot dasar publik (sudah terdownload
# sebagai file *_base-*.pth) dengan mengisi 2 var ini. Butuh Python 3.9 venv
# + paket comics-ocr (torch 1.9 tidak bisa di Python 3.12), misal:
#   COMICS_PYTHON=C:\venvs\comics\Scripts\python.exe
# COMICS_PYTHON=C:\venvs\comics\Scripts\python.exe
# COMICS_DET_CKPT=detector/models/comics_text_plus/fcenet_r50dcnv2_fpn_1500e_ctw1500_base-e326d7ec.pth
# COMICS_RECOG_CKPT=detector/models/comics_text_plus/master_r31_12e_ST_MJ_SA_base-787edd36.pth
# COMICS_CONF=0.3
# COMICS_TIMEOUT_MS=300000
